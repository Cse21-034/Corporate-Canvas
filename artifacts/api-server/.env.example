# Injected automatically by Replit and Render — do not set manually.
# DATABASE_URL=

# Required — sign session cookies. On Render this is auto-generated by render.yaml.
SESSION_SECRET=change-me-in-production

# Comma-separated list of allowed frontend origins (production only).
# Example: https://your-app.vercel.app
# On Replit this is unused (development mode allows all origins).
CORS_ORIGIN=

# Optional
NODE_ENV=development
LOG_LEVEL=info
